# ============================================================
# CFB Predictor 2026 — .gitignore
# NOTE: docs/, reports/, CLAUDE.md, and .claude/ (except local
# settings) are deliberately TRACKED. The old blanket "*.md"
# ignore rule is gone — markdown docs are load-bearing here.
# ============================================================

# Environment variables & secrets
.env
.env.local
.env.*.local
api_keys.txt
secrets.txt
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# Virtual environments (both the dir form and a stray FILE named venv)
venv
venv/
env/
ENV/
.venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/
*.cache
.ipynb_checkpoints

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Project runtime artifacts (regenerable; NOT the tracked data)
data/cache/
data/odds_quota.json
output/
logs/
*.log
*.tmp
*.temp
temp/
tmp/
*.bak
*.backup

# Local-only Claude Code state. Per D3 (docs/DECISIONS.md), .claude/ config,
# CLAUDE.md, and docs are now COMMITTED — only machine-local and secret
# bits stay ignored.
.claude/settings.local.json
.claude/memory/
CLAUDE.local.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node (if JS tooling ever appears)
node_modules/

# ============================================================
# Intentionally NOT ignored (do not re-add):
#   *.md                    -> docs, reports, CLAUDE.md must commit
#   data/predictions/       -> the audit trail
#   data/results/           -> the audit trail
#   data/snapshots/         -> reproducibility bundles + provenance
#   data/lines/             -> append-only line-observation series (closing lines / CLV)
#   data/ratings/           -> derived per-week power ratings (D13; inspection + projections)
#   data/projections/       -> season drift tracking
#   reports/                -> committed by the weekly pipeline
# ============================================================
